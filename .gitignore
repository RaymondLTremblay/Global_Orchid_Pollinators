# --- R / RStudio -----------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# --- macOS -----------------------------------------------------------------
.DS_Store

# --- Office lock files -----------------------------------------------------
# Excel/Word leave these behind while a file is open.
~$*

# --- Quarto build output ---------------------------------------------------
# All of this is regenerated by `quarto render`, so it does not belong in the
# repo. Keeping it out also stops the rendered HTML from showing up as a huge
# unreadable diff every time someone re-renders.
#
# NOTE the leading slash on each file: it anchors the pattern to the repo root.
# Without it, `mapa_final_static.html` would also match
# `docs/mapa_final_static.html` -- the copy GitHub Pages actually serves.
/.quarto/
/mapa_final_files/
/pollinators_wrangling_files/
/pollinator_map_files/
/mapa_final.html
/mapa_final_static.html
/pollinator_map.html
/pollinators_wrangling.html
/PROGRESS.html

# --- Deployment ------------------------------------------------------------
rsconnect/

# --- Superseded workbooks --------------------------------------------------
# Kept locally (and in Dropbox's own version history) as provenance, but not
# worth ~5 MB of binary .xlsx in the repo.
_archive/

# --- Internal correspondence -----------------------------------------------
# The repo is public; this one names the students and their assignments.
correo_estudiantes_coordenadas.md
correo_correccion_coordenadas.md
